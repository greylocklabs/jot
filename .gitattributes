# Keep the website, development tooling and planning docs out of release tarballs, so the
# source distro maintainers review contains only what builds the application.
# Directories are listed without a trailing slash, which export-ignore requires.
www                     export-ignore
.github                 export-ignore
# The installer's test and its stand-in release go with the site. The sample vault
# stays, since the tests read it.
tests/install_test.sh   export-ignore
tests/data/github-release.json export-ignore
docs                    export-ignore
.githooks               export-ignore
.gitattributes          export-ignore
.editorconfig           export-ignore
.clang-format           export-ignore
.qmlformat.ini          export-ignore
.qmllint.ini            export-ignore
.clangd                 export-ignore
Makefile                export-ignore
.prettierrc             export-ignore
.prettierignore         export-ignore
.markdownlint-cli2.yaml export-ignore
core                    export-ignore
.gitmodules             export-ignore
package.json            export-ignore
package-lock.json       export-ignore
commitlint.config.mjs   export-ignore
CONTRIBUTING.md         export-ignore
GUIDELINES.md           export-ignore
CLAUDE.md               export-ignore
AGENTS.md               export-ignore
RELEASING.md            export-ignore
cliff.toml              export-ignore
